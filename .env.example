# Copy to .env and add your credentials. Never commit real keys.
# For a single-key setup, use OpenRouter and set only this key.
LLM_ROUTER_API_KEY=
LLM_ROUTER_PROVIDERS=openrouter,groq,google,anthropic,openai

# Optional direct-provider keys. Only providers with keys are enabled.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional model overrides
# LLM_ROUTER_MODEL_OPENROUTER=openrouter/auto
# LLM_ROUTER_MODEL_OPENAI=gpt-4o-mini
# LLM_ROUTER_MODEL_ANTHROPIC=claude-3-5-haiku-latest
# LLM_ROUTER_MODEL_GOOGLE=gemini-2.0-flash
# LLM_ROUTER_MODEL_GROQ=llama-3.3-70b-versatile

# Optional local monthly request caps (not provider-reported quota)
# LLM_ROUTER_MONTHLY_LIMIT_OPENROUTER=1000
# LLM_ROUTER_MONTHLY_LIMIT_GROQ=500

# Optional runtime settings
# LLM_ROUTER_TIMEOUT=45
# LLM_ROUTER_DB_PATH=~/.local/share/llm-free-tier-router/usage.sqlite3
# LLM_ROUTER_OPENROUTER_SITE_URL=https://example.com
# LLM_ROUTER_OPENROUTER_APP_NAME=My LLM CLI
